# ─── VÉLORA API environment ───
# Copy to .env and fill in. Never commit .env. Every variable is documented in docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API with cookies
# Add http://localhost:8081 to try the mobile app in a browser (Expo web).
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails, e.g. password-reset links)
WEB_APP_URL=http://localhost:3000

# MySQL 8 / MariaDB 10.4+. Use a dedicated user in production, never root.
DATABASE_URL=mysql://root:@localhost:3306/velora_dev

# JWT — generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false

# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed data (development only). The seeded super admin signs in with these.
SEED_SUPER_ADMIN_EMAIL=admin@velora.test
SEED_SUPER_ADMIN_PASSWORD=Velora-Dev-Admin-2026!
# Password given to every other seeded demo account (staff, vendor, customers)
SEED_DEMO_PASSWORD=Velora-Dev-Demo-2026!

# Public URL of this API (payment provider callbacks are sent here)
API_PUBLIC_URL=http://localhost:4000

# ─── Payments ───
# A provider is offered at checkout only when its keys are set. Never commit real keys.
# Paystack (cards + Mobile Money): Dashboard → Settings → API Keys & Webhooks.
# Set the webhook URL there to  <API_PUBLIC_URL>/api/v1/payments/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Hubtel Online Checkout: set all three or none.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
# Development only: a fake hosted checkout so the online-payment flow can be exercised without keys.
# The API refuses to start with this enabled when NODE_ENV=production.
PAYMENT_SIMULATOR=true
# Minutes an unpaid online order holds its stock before it is cancelled
PAYMENT_TTL_MINUTES=30

# ─── Search ───
# Meilisearch is used when set and reachable (docker compose up -d meilisearch); otherwise the
# built-in engine (synonyms, typo correction, relevance ranking) is used automatically.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# ─── Email and SMS ───
# "log" writes messages to the API log (development). Use "smtp" / "hubtel" to really send.
MAIL_DRIVER=log
SMTP_URL=
MAIL_FROM="VÉLORA <no-reply@velora.test>"
SMS_DRIVER=log
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
SMS_SENDER_ID=VELORA
# "log" writes app push notifications to the API log; "expo" sends them through the Expo push service.
PUSH_DRIVER=log
# Only needed if "enhanced push security" is on for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Later phases (not read yet) ───
REDIS_URL=redis://localhost:6379
CLOUDINARY_URL=

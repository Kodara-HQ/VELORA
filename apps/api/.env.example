# ─── VÉLORA API environment ───
# Copy to .env and fill in. Never commit .env. Every variable is documented in docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails, e.g. password-reset links)
WEB_APP_URL=http://localhost:3000

# MySQL 8 / MariaDB 10.4+. Use a dedicated user in production, never root.
DATABASE_URL=mysql://root:@localhost:3306/velora_dev

# JWT — generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false

# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed data (development only). The seeded super admin signs in with these.
SEED_SUPER_ADMIN_EMAIL=admin@velora.test
SEED_SUPER_ADMIN_PASSWORD=Velora-Dev-Admin-2026!
# Password given to every other seeded demo account (staff, vendor, customers)
SEED_DEMO_PASSWORD=Velora-Dev-Demo-2026!

# ─── Later phases (not read yet) ───
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
CLOUDINARY_URL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
SMTP_URL=
SMS_PROVIDER_API_KEY=
EXPO_ACCESS_TOKEN=

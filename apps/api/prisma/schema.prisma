// VÉLORA — relational schema (MySQL 8 / MariaDB 10.4+)
// Conventions:
//   * Integer auto-increment primary keys everywhere.
//   * snake_case table and column names (@@map / @map); camelCase in TypeScript.
//   * Money is DECIMAL(12,2) plus an ISO-4217 currency code (GHS by default).
//   * deleted_at marks soft-deleted rows on business entities that must stay referable from history.
//   * Orders and order items snapshot names, prices and addresses so history never changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique @db.VarChar(191)
  phone           String?    @unique @db.VarChar(32)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(512)
  status          UserStatus @default(ACTIVE)
  referralCode    String?    @unique @map("referral_code") @db.VarChar(20)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  loginActivities     LoginActivity[]
  customer            Customer?
  ownedVendors        Vendor[]             @relation("VendorOwner")
  vendorApplications  VendorApplication[]  @relation("Applicant")
  reviewedApplications VendorApplication[] @relation("ApplicationReviewer")
  addresses           Address[]
  wishlists           Wishlist[]
  carts               Cart[]
  orders              Order[]
  reviews             ProductReview[]
  questions           ProductQuestion[]    @relation("QuestionAsker")
  answers             ProductQuestion[]    @relation("QuestionAnswerer")
  productViews        ProductView[]
  returns             Return[]
  loyaltyAccount      LoyaltyAccount?
  notifications       Notification[]
  pushTokens          PushToken[]
  auditLogs           AuditLog[]
  stockMovements      StockMovement[]
  couponRedemptions   CouponRedemption[]
  referralsMade       Referral[]           @relation("Referrer")
  referredBy          Referral?            @relation("Referee")
  processedRefunds    Refund[]             @relation("RefundProcessor")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(80)
  module      String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy Int?     @map("assigned_by")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed. Every refresh rotates the token; presenting a
/// revoked token from the same family revokes the whole family (theft detection).
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  familyId   String    @map("family_id") @db.Char(36)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy Int?      @map("replaced_by")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginActivity {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  email     String   @db.VarChar(191)
  success   Boolean
  reason    String?  @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_activities")
}

// ───────────────────────────── Customers & vendors ─────────────────────────────

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

model Customer {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  gender            Gender    @default(UNSPECIFIED)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  segment           String?   @db.VarChar(50)
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  notificationPrefs Json?     @map("notification_prefs")
  lifetimeValue     Decimal   @default(0) @map("lifetime_value") @db.Decimal(12, 2)
  orderCount        Int       @default(0) @map("order_count")
  lastOrderAt       DateTime? @map("last_order_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([segment])
  @@map("customers")
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Vendor {
  id             Int          @id @default(autoincrement())
  ownerUserId    Int          @map("owner_user_id")
  businessName   String       @map("business_name") @db.VarChar(150)
  slug           String       @unique @db.VarChar(160)
  email          String       @db.VarChar(191)
  phone          String?      @db.VarChar(32)
  description    String?      @db.Text
  logoUrl        String?      @map("logo_url") @db.VarChar(512)
  status         VendorStatus @default(PENDING)
  commissionRate Decimal      @default(15.00) @map("commission_rate") @db.Decimal(5, 2)
  payoutMethod   String?      @map("payout_method") @db.VarChar(30)
  payoutDetails  Json?        @map("payout_details")
  rating         Decimal      @default(0) @db.Decimal(3, 2)
  verifiedAt     DateTime?    @map("verified_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  owner       User               @relation("VendorOwner", fields: [ownerUserId], references: [id])
  products    Product[]
  orderItems  OrderItem[]
  commissions VendorCommission[]
  settlements VendorSettlement[]
  warehouses  Warehouse[]

  @@index([ownerUserId])
  @@index([status])
  @@map("vendors")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VendorApplication {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  businessName       String            @map("business_name") @db.VarChar(150)
  registrationNumber String?           @map("registration_number") @db.VarChar(80)
  taxId              String?           @map("tax_id") @db.VarChar(80)
  contactPhone       String            @map("contact_phone") @db.VarChar(32)
  businessAddress    String            @map("business_address") @db.VarChar(255)
  productCategories  Json?             @map("product_categories")
  documents          Json?
  status             ApplicationStatus @default(SUBMITTED)
  reviewedById       Int?              @map("reviewed_by")
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNotes        String?           @map("review_notes") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation("Applicant", fields: [userId], references: [id])
  reviewedBy         User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("vendor_applications")
}

model Address {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  label          String?   @db.VarChar(50)
  recipientName  String    @map("recipient_name") @db.VarChar(150)
  phone          String    @db.VarChar(32)
  line1          String    @db.VarChar(255)
  line2          String?   @db.VarChar(255)
  city           String    @db.VarChar(100)
  region         String    @db.VarChar(100)
  /// GhanaPost GPS digital address, e.g. GA-183-8164
  digitalAddress String?   @map("digital_address") @db.VarChar(20)
  landmark       String?   @db.VarChar(255)
  countryCode    String    @default("GH") @map("country_code") @db.Char(2)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id          Int        @id @default(autoincrement())
  parentId    Int?       @map("parent_id")
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.Text
  imageUrl    String?    @map("image_url") @db.VarChar(512)
  sizeGuide   Json?      @map("size_guide")
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  logoUrl     String?   @map("logo_url") @db.VarChar(512)
  description String?   @db.Text
  isFeatured  Boolean   @default(false) @map("is_featured")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  products    Product[]

  @@map("brands")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

model Product {
  id               Int           @id @default(autoincrement())
  /// NULL = platform-owned (VÉLORA first-party stock)
  vendorId         Int?          @map("vendor_id")
  categoryId       Int           @map("category_id")
  brandId          Int?          @map("brand_id")
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  styleCode        String        @unique @map("style_code") @db.VarChar(64)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?       @db.Text
  material         String?       @db.VarChar(255)
  careInstructions String?       @map("care_instructions") @db.VarChar(500)
  videoUrl         String?       @map("video_url") @db.VarChar(512)
  basePrice        Decimal       @map("base_price") @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  currency         String        @default("GHS") @db.Char(3)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  tags             Json?
  avgRating        Decimal       @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount      Int           @default(0) @map("review_count")
  soldCount        Int           @default(0) @map("sold_count")
  viewCount        Int           @default(0) @map("view_count")
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  vendor            Vendor?             @relation(fields: [vendorId], references: [id])
  category          Category            @relation(fields: [categoryId], references: [id])
  brand             Brand?              @relation(fields: [brandId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  attributes        ProductAttribute[]
  reviews           ProductReview[]
  questions         ProductQuestion[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  views             ProductView[]
  promotionProducts PromotionProduct[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([vendorId, status])
  @@index([brandId])
  @@index([soldCount])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  /// Optional: image belongs to a specific colourway
  color     String?  @db.VarChar(60)
  url       String   @db.VarChar(512)
  storageKey String? @map("storage_key") @db.VarChar(255)
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// A sellable SKU. Every variant has its own price override and its own stock per warehouse.
model ProductVariant {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  sku            String    @unique @db.VarChar(80)
  barcode        String?   @unique @db.VarChar(64)
  color          String?   @db.VarChar(60)
  colorHex       String?   @map("color_hex") @db.Char(7)
  size           String?   @db.VarChar(30)
  price          Decimal?  @db.Decimal(12, 2)
  compareAtPrice Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal?  @map("cost_price") @db.Decimal(12, 2)
  weightGrams    Int?      @map("weight_grams")
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory           Inventory[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  stockTransferItems  StockTransferItem[]
  exchangeReturnItems ReturnItem[]         @relation("ExchangeVariant")

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  name      String  @db.VarChar(80)
  value     String  @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([name, value])
  @@map("product_attributes")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FitFeedback {
  RUNS_SMALL
  TRUE_TO_SIZE
  RUNS_LARGE
}

model ProductReview {
  id               Int              @id @default(autoincrement())
  productId        Int              @map("product_id")
  userId           Int              @map("user_id")
  orderItemId      Int?             @unique @map("order_item_id")
  rating           Int              @db.TinyInt
  title            String?          @db.VarChar(150)
  body             String?          @db.Text
  images           Json?
  fit              FitFeedback?
  isVerifiedBuyer  Boolean          @default(false) @map("is_verified_buyer")
  status           ModerationStatus @default(PENDING)
  helpfulCount     Int              @default(0) @map("helpful_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])
  orderItem        OrderItem?       @relation(fields: [orderItemId], references: [id])

  @@index([productId, status, createdAt])
  @@index([userId])
  @@map("product_reviews")
}

model ProductQuestion {
  id         Int              @id @default(autoincrement())
  productId  Int              @map("product_id")
  userId     Int              @map("user_id")
  question   String           @db.VarChar(500)
  answer     String?          @db.Text
  answeredBy Int?             @map("answered_by")
  answeredAt DateTime?        @map("answered_at")
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User             @relation("QuestionAsker", fields: [userId], references: [id])
  answerer   User?            @relation("QuestionAnswerer", fields: [answeredBy], references: [id])

  @@index([productId, status])
  @@map("product_questions")
}

/// Recently-viewed history and input for recommendations.
model ProductView {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(64)
  productId Int      @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@index([productId])
  @@map("product_views")
}

model SearchTerm {
  id             Int      @id @default(autoincrement())
  term           String   @unique @db.VarChar(120)
  searchCount    Int      @default(1) @map("search_count")
  resultCount    Int      @default(0) @map("result_count")
  lastSearchedAt DateTime @default(now()) @map("last_searched_at")

  @@index([searchCount])
  @@map("search_terms")
}

// ───────────────────────────── Wishlist & cart ─────────────────────────────

model Wishlist {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  name       String         @default("My Wishlist") @db.VarChar(100)
  isPublic   Boolean        @default(false) @map("is_public")
  shareToken String?        @unique @map("share_token") @db.VarChar(40)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         Int             @id @default(autoincrement())
  wishlistId Int             @map("wishlist_id")
  productId  Int             @map("product_id")
  variantId  Int?            @map("variant_id")
  addedAt    DateTime        @default(now()) @map("added_at")
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  MERGED
}

model Cart {
  id                  Int        @id @default(autoincrement())
  userId              Int?       @map("user_id")
  /// Opaque token for guest carts (stored in a cookie / device storage)
  guestToken          String?    @unique @map("guest_token") @db.VarChar(64)
  status              CartStatus @default(ACTIVE)
  currency            String     @default("GHS") @db.Char(3)
  couponId            Int?       @map("coupon_id")
  email               String?    @db.VarChar(191)
  abandonedNotifiedAt DateTime?  @map("abandoned_notified_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  user                User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon              Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items               CartItem[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int            @map("cart_id")
  variantId Int            @map("variant_id")
  quantity  Int
  addedAt   DateTime       @default(now()) @map("added_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ───────────────────────────── Orders, payments, refunds ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id                Int           @id @default(autoincrement())
  orderNumber       String        @unique @map("order_number") @db.VarChar(30)
  userId            Int?          @map("user_id")
  guestEmail        String?       @map("guest_email") @db.VarChar(191)
  guestPhone        String?       @map("guest_phone") @db.VarChar(32)
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  currency          String        @default("GHS") @db.Char(3)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal     Decimal       @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal       @map("grand_total") @db.Decimal(12, 2)
  refundedTotal     Decimal       @default(0) @map("refunded_total") @db.Decimal(12, 2)
  couponId          Int?          @map("coupon_id")
  couponCode        String?       @map("coupon_code") @db.VarChar(40)
  loyaltyPointsUsed Int           @default(0) @map("loyalty_points_used")
  shippingMethodId  Int?          @map("shipping_method_id")
  /// Snapshot of the delivery address at the time of purchase
  shippingAddress   Json          @map("shipping_address")
  billingAddress    Json?         @map("billing_address")
  customerNote      String?       @map("customer_note") @db.VarChar(500)
  /// Client-generated key; a retried checkout with the same key returns the same order
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(64)
  channel           String        @default("web") @db.VarChar(20)
  placedAt          DateTime      @default(now()) @map("placed_at")
  paidAt            DateTime?     @map("paid_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelReason      String?       @map("cancel_reason") @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User?               @relation(fields: [userId], references: [id])
  coupon            Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingMethod    ShippingMethod?     @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  returns           Return[]
  statusHistory     OrderStatusHistory[]
  couponRedemptions CouponRedemption[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([guestEmail])
  @@map("orders")
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  orderId          Int             @map("order_id")
  productId        Int?            @map("product_id")
  variantId        Int?            @map("variant_id")
  vendorId         Int?            @map("vendor_id")
  warehouseId      Int?            @map("warehouse_id")
  productName      String          @map("product_name") @db.VarChar(200)
  variantLabel     String?         @map("variant_label") @db.VarChar(120)
  sku              String          @db.VarChar(80)
  imageUrl         String?         @map("image_url") @db.VarChar(512)
  unitPrice        Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity         Int
  discountAmount   Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal        Decimal         @map("line_total") @db.Decimal(12, 2)
  quantityReturned Int             @default(0) @map("quantity_returned")
  createdAt        DateTime        @default(now()) @map("created_at")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  vendor      Vendor?           @relation(fields: [vendorId], references: [id])
  warehouse   Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  review      ProductReview?
  returnItems ReturnItem[]
  commission  VendorCommission?

  @@index([orderId])
  @@index([vendorId, createdAt])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int         @id @default(autoincrement())
  orderId    Int         @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  note       String?     @db.VarChar(500)
  changedBy  Int?        @map("changed_by")
  createdAt  DateTime    @default(now()) @map("created_at")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum PaymentProvider {
  PAYSTACK
  HUBTEL
  CASH_ON_DELIVERY
}

enum PaymentMethod {
  MOMO_MTN
  MOMO_TELECEL
  MOMO_AT
  CARD
  BANK_TRANSFER
  CASH
}

enum PaymentTxnStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

model Payment {
  id                Int              @id @default(autoincrement())
  orderId           Int              @map("order_id")
  provider          PaymentProvider
  method            PaymentMethod
  /// Our reference, sent to the provider; unique so a payment can never be applied twice
  reference         String           @unique @db.VarChar(64)
  providerReference String?          @map("provider_reference") @db.VarChar(128)
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("GHS") @db.Char(3)
  status            PaymentTxnStatus @default(INITIATED)
  payerPhone        String?          @map("payer_phone") @db.VarChar(32)
  cardLast4         String?          @map("card_last4") @db.Char(4)
  cardBrand         String?          @map("card_brand") @db.VarChar(20)
  failureReason     String?          @map("failure_reason") @db.VarChar(255)
  providerResponse  Json?            @map("provider_response")
  verifiedAt        DateTime?        @map("verified_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  order             Order            @relation(fields: [orderId], references: [id])
  refunds           Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every inbound provider webhook is recorded once; the unique key makes processing idempotent.
model WebhookEvent {
  id          Int             @id @default(autoincrement())
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(128)
  eventType   String          @map("event_type") @db.VarChar(80)
  payload     Json
  signatureOk Boolean         @map("signature_ok")
  processedAt DateTime?       @map("processed_at")
  error       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

model Refund {
  id                Int          @id @default(autoincrement())
  orderId           Int          @map("order_id")
  paymentId         Int?         @map("payment_id")
  returnId          Int?         @map("return_id")
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("GHS") @db.Char(3)
  reason            String       @db.VarChar(255)
  status            RefundStatus @default(REQUESTED)
  method            String?      @db.VarChar(30)
  providerReference String?      @map("provider_reference") @db.VarChar(128)
  processedById     Int?         @map("processed_by")
  processedAt       DateTime?    @map("processed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  order             Order        @relation(fields: [orderId], references: [id])
  payment           Payment?     @relation(fields: [paymentId], references: [id])
  return            Return?      @relation(fields: [returnId], references: [id])
  processedBy       User?        @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

// ───────────────────────────── Shipping ─────────────────────────────

model ShippingZone {
  id        Int              @id @default(autoincrement())
  name      String           @db.VarChar(100)
  /// Regions covered by this zone, e.g. ["Greater Accra"]
  regions   Json
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  methods   ShippingMethod[]

  @@map("shipping_zones")
}

model ShippingMethod {
  id                Int          @id @default(autoincrement())
  zoneId            Int          @map("zone_id")
  code              String       @db.VarChar(40)
  name              String       @db.VarChar(100)
  carrier           String?      @db.VarChar(80)
  fee               Decimal      @db.Decimal(12, 2)
  freeOverAmount    Decimal?     @map("free_over_amount") @db.Decimal(12, 2)
  minDays           Int          @map("min_days")
  maxDays           Int          @map("max_days")
  isActive          Boolean      @default(true) @map("is_active")
  sortOrder         Int          @default(0) @map("sort_order")
  zone              ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders            Order[]

  @@unique([zoneId, code])
  @@map("shipping_methods")
}

enum ShipmentStatus {
  PENDING
  PACKED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_SENDER
}

model Shipment {
  id             Int             @id @default(autoincrement())
  orderId        Int             @map("order_id")
  warehouseId    Int?            @map("warehouse_id")
  carrier        String          @db.VarChar(80)
  trackingNumber String?         @unique @map("tracking_number") @db.VarChar(80)
  status         ShipmentStatus  @default(PENDING)
  riderName      String?         @map("rider_name") @db.VarChar(120)
  riderPhone     String?         @map("rider_phone") @db.VarChar(32)
  dispatchedAt   DateTime?       @map("dispatched_at")
  deliveredAt    DateTime?       @map("delivered_at")
  proofOfDelivery String?        @map("proof_of_delivery") @db.VarChar(512)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  order          Order           @relation(fields: [orderId], references: [id])
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  events         ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model ShipmentEvent {
  id          Int            @id @default(autoincrement())
  shipmentId  Int            @map("shipment_id")
  status      ShipmentStatus
  description String         @db.VarChar(255)
  location    String?        @db.VarChar(150)
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ───────────────────────────── Inventory & purchasing ─────────────────────────────

model Warehouse {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(120)
  /// NULL = VÉLORA warehouse; otherwise a vendor's own stock location
  vendorId  Int?      @map("vendor_id")
  address   String?   @db.VarChar(255)
  city      String?   @db.VarChar(100)
  region    String?   @db.VarChar(100)
  phone     String?   @db.VarChar(32)
  isActive  Boolean   @default(true) @map("is_active")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  inventory      Inventory[]
  shipments      Shipment[]
  orderItems     OrderItem[]
  purchaseOrders PurchaseOrder[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

/// Stock of one variant in one warehouse. available = on_hand - reserved.
model Inventory {
  id               Int             @id @default(autoincrement())
  variantId        Int             @map("variant_id")
  warehouseId      Int             @map("warehouse_id")
  quantityOnHand   Int             @default(0) @map("quantity_on_hand")
  quantityReserved Int             @default(0) @map("quantity_reserved")
  reorderLevel     Int             @default(5) @map("reorder_level")
  averageCost      Decimal         @default(0) @map("average_cost") @db.Decimal(12, 2)
  binLocation      String?         @map("bin_location") @db.VarChar(40)
  updatedAt        DateTime        @updatedAt @map("updated_at")
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])
  movements        StockMovement[]

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE
  RESERVATION
  RESERVATION_RELEASE
  CUSTOMER_RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
}

/// Append-only ledger. Every change to inventory writes one row here in the same transaction.
model StockMovement {
  id            Int               @id @default(autoincrement())
  inventoryId   Int               @map("inventory_id")
  type          StockMovementType
  /// Signed change to quantity_on_hand (reservations change reserved, quantity here is informational)
  quantity      Int
  balanceAfter  Int               @map("balance_after")
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  referenceType String?           @map("reference_type") @db.VarChar(40)
  referenceId   Int?              @map("reference_id")
  note          String?           @db.VarChar(255)
  userId        Int?              @map("user_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  inventory     Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  transferNumber  String              @unique @map("transfer_number") @db.VarChar(30)
  fromWarehouseId Int                 @map("from_warehouse_id")
  toWarehouseId   Int                 @map("to_warehouse_id")
  status          TransferStatus      @default(DRAFT)
  note            String?             @db.VarChar(255)
  createdById     Int?                @map("created_by")
  shippedAt       DateTime?           @map("shipped_at")
  receivedAt      DateTime?           @map("received_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items           StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         Int            @id @default(autoincrement())
  transferId Int            @map("transfer_id")
  variantId  Int            @map("variant_id")
  quantity   Int
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([transferId, variantId])
  @@map("stock_transfer_items")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(150)
  contactName    String?         @map("contact_name") @db.VarChar(120)
  email          String?         @db.VarChar(191)
  phone          String?         @db.VarChar(32)
  address        String?         @db.VarChar(255)
  country        String?         @db.VarChar(60)
  paymentTerms   String?         @map("payment_terms") @db.VarChar(100)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  poNumber    String              @unique @map("po_number") @db.VarChar(30)
  supplierId  Int                 @map("supplier_id")
  warehouseId Int                 @map("warehouse_id")
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @default("GHS") @db.Char(3)
  totalCost   Decimal             @default(0) @map("total_cost") @db.Decimal(12, 2)
  expectedAt  DateTime?           @map("expected_at")
  note        String?             @db.VarChar(500)
  createdById Int?                @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int                @id @default(autoincrement())
  purchaseOrderId  Int                @map("purchase_order_id")
  variantId        Int                @map("variant_id")
  quantityOrdered  Int                @map("quantity_ordered")
  quantityReceived Int                @default(0) @map("quantity_received")
  unitCost         Decimal            @map("unit_cost") @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant     @relation(fields: [variantId], references: [id])
  receiptItems     GoodsReceiptItem[]

  @@unique([purchaseOrderId, variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  receiptNumber   String             @unique @map("receipt_number") @db.VarChar(30)
  purchaseOrderId Int                @map("purchase_order_id")
  receivedById    Int?               @map("received_by")
  note            String?            @db.VarChar(500)
  receivedAt      DateTime           @default(now()) @map("received_at")
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items           GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  Int               @id @default(autoincrement())
  goodsReceiptId      Int               @map("goods_receipt_id")
  purchaseOrderItemId Int               @map("purchase_order_item_id")
  quantityReceived    Int               @map("quantity_received")
  quantityRejected    Int               @default(0) @map("quantity_rejected")
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("goods_receipt_items")
}

// ───────────────────────────── Marketing ─────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id                 Int                @id @default(autoincrement())
  code               String             @unique @db.VarChar(40)
  description        String?            @db.VarChar(255)
  type               DiscountType
  value              Decimal            @db.Decimal(12, 2)
  minOrderAmount     Decimal?           @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?           @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit         Int?               @map("usage_limit")
  usageLimitPerUser  Int?               @default(1) @map("usage_limit_per_user")
  usedCount          Int                @default(0) @map("used_count")
  firstOrderOnly     Boolean            @default(false) @map("first_order_only")
  promotionId        Int?               @map("promotion_id")
  startsAt           DateTime?          @map("starts_at")
  endsAt             DateTime?          @map("ends_at")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  promotion          Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  carts              Cart[]
  orders             Order[]
  redemptions        CouponRedemption[]

  @@index([isActive, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  userId         Int?     @map("user_id")
  orderId        Int      @unique @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum PromotionType {
  FLASH_SALE
  PERCENTAGE_OFF
  FIXED_AMOUNT_OFF
  BUY_X_GET_Y
  BUNDLE
  FREE_SHIPPING
}

model Promotion {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(160)
  type        PromotionType
  /// Percentage or amount, depending on type
  value       Decimal?           @db.Decimal(12, 2)
  /// Type-specific rules, e.g. { buyQty: 1, getQty: 1 } or { bundlePrice: "299.00" }
  rules       Json?
  campaign    String?            @db.VarChar(100)
  bannerUrl   String?            @map("banner_url") @db.VarChar(512)
  headline    String?            @db.VarChar(150)
  priority    Int                @default(0)
  startsAt    DateTime           @map("starts_at")
  endsAt      DateTime           @map("ends_at")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  products    PromotionProduct[]
  coupons     Coupon[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId Int       @map("promotion_id")
  productId   Int       @map("product_id")
  /// Optional fixed sale price for flash sales
  salePrice   Decimal?  @map("sale_price") @db.Decimal(12, 2)
  stockLimit  Int?      @map("stock_limit")
  soldCount   Int       @default(0) @map("sold_count")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model LoyaltyAccount {
  id             Int                  @id @default(autoincrement())
  userId         Int                  @unique @map("user_id")
  pointsBalance  Int                  @default(0) @map("points_balance")
  lifetimePoints Int                  @default(0) @map("lifetime_points")
  tier           LoyaltyTier          @default(BRONZE)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REFERRAL_BONUS
  REVIEW_BONUS
  REVERSAL
}

model LoyaltyTransaction {
  id           Int            @id @default(autoincrement())
  accountId    Int            @map("account_id")
  type         LoyaltyTxnType
  /// Signed: positive = earned, negative = spent / expired
  points       Int
  balanceAfter Int            @map("balance_after")
  orderId      Int?           @map("order_id")
  description  String?        @db.VarChar(255)
  expiresAt    DateTime?      @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

model Referral {
  id         Int            @id @default(autoincrement())
  referrerId Int            @map("referrer_id")
  refereeId  Int            @unique @map("referee_id")
  status     ReferralStatus @default(PENDING)
  rewardedAt DateTime?      @map("rewarded_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  referrer   User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User           @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  source         String?   @db.VarChar(40)
  confirmedAt    DateTime? @map("confirmed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ───────────────────────────── Notifications ─────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  channel   NotificationChannel
  type      String              @db.VarChar(60)
  title     String              @db.VarChar(200)
  body      String              @db.Text
  data      Json?
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  failedAt  DateTime?           @map("failed_at")
  createdAt DateTime            @default(now()) @map("created_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  lastSeen  DateTime @default(now()) @map("last_seen")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ───────────────────────────── Returns ─────────────────────────────

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEMS_RECEIVED
  REFUNDED
  EXCHANGED
  CLOSED
}

enum ReturnReason {
  WRONG_SIZE
  NOT_AS_DESCRIBED
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  CHANGED_MIND
  LATE_DELIVERY
  OTHER
}

model Return {
  id           Int          @id @default(autoincrement())
  returnNumber String       @unique @map("return_number") @db.VarChar(30)
  orderId      Int          @map("order_id")
  userId       Int?         @map("user_id")
  type         ReturnType   @default(RETURN)
  status       ReturnStatus @default(REQUESTED)
  reason       ReturnReason
  customerNote String?      @map("customer_note") @db.VarChar(1000)
  adminNote    String?      @map("admin_note") @db.VarChar(1000)
  images       Json?
  approvedAt   DateTime?    @map("approved_at")
  receivedAt   DateTime?    @map("received_at")
  closedAt     DateTime?    @map("closed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  order        Order        @relation(fields: [orderId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  items        ReturnItem[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("returns")
}

model ReturnItem {
  id                Int             @id @default(autoincrement())
  returnId          Int             @map("return_id")
  orderItemId       Int             @map("order_item_id")
  quantity          Int
  exchangeVariantId Int?            @map("exchange_variant_id")
  condition         String?         @db.VarChar(40)
  restock           Boolean         @default(true)
  return            Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id])
  exchangeVariant   ProductVariant? @relation("ExchangeVariant", fields: [exchangeVariantId], references: [id])

  @@index([returnId])
  @@map("return_items")
}

// ───────────────────────────── Vendor finance ─────────────────────────────

enum CommissionStatus {
  PENDING
  ELIGIBLE
  SETTLED
  REVERSED
}

/// One row per vendor order line: gross, platform commission and vendor net.
model VendorCommission {
  id               Int               @id @default(autoincrement())
  vendorId         Int               @map("vendor_id")
  orderItemId      Int               @unique @map("order_item_id")
  rate             Decimal           @db.Decimal(5, 2)
  grossAmount      Decimal           @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal           @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal           @map("net_amount") @db.Decimal(12, 2)
  status           CommissionStatus  @default(PENDING)
  /// Becomes ELIGIBLE after the return window closes
  eligibleAt       DateTime?         @map("eligible_at")
  settlementId     Int?              @map("settlement_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  orderItem        OrderItem         @relation(fields: [orderItemId], references: [id])
  settlement       VendorSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([vendorId, status])
  @@map("vendor_commissions")
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PROCESSING
  PAID
  FAILED
}

model VendorSettlement {
  id                Int                @id @default(autoincrement())
  vendorId          Int                @map("vendor_id")
  reference         String             @unique @db.VarChar(40)
  periodStart       DateTime           @map("period_start") @db.Date
  periodEnd         DateTime           @map("period_end") @db.Date
  grossAmount       Decimal            @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount  Decimal            @map("commission_amount") @db.Decimal(12, 2)
  adjustments       Decimal            @default(0) @db.Decimal(12, 2)
  netAmount         Decimal            @map("net_amount") @db.Decimal(12, 2)
  currency          String             @default("GHS") @db.Char(3)
  status            SettlementStatus   @default(DRAFT)
  payoutReference   String?            @map("payout_reference") @db.VarChar(128)
  approvedBy        Int?               @map("approved_by")
  paidAt            DateTime?          @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  vendor            Vendor             @relation(fields: [vendorId], references: [id])
  commissions       VendorCommission[]

  @@index([vendorId, status])
  @@map("vendor_settlements")
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  group       String   @db.VarChar(50)
  key         String   @db.VarChar(80)
  value       Json
  /// Public settings (store name, currency…) can be read by the storefront without auth
  isPublic    Boolean  @default(false) @map("is_public")
  description String?  @db.VarChar(255)
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([group, key])
  @@map("system_settings")
}

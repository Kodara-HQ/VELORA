# Where the app finds the VÉLORA API. Copy to .env and adjust.
#  - Expo web / iOS simulator on this computer: http://localhost:4000/api/v1
#  - Android emulator:                         http://10.0.2.2:4000/api/v1
#  - A real phone on the same Wi-Fi:           http://<your computer's LAN IP>:4000/api/v1
#    (also add that origin to CORS_ORIGINS only if you use Expo web from another device)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
